    {
      "name": "3. Lancer classification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{API_TOKEN}}"
          },
          {
            "key": "IB-Context",
            "value": "{{IB_CONTEXT}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"batch_id\": \"{{BATCH_ID}}\", \"app_name\": \"app_doc_classification\"}"
        },
        "url": {
          "raw": "{{API_ROOT}}/v2/apps/runs",
          "host": ["{{API_ROOT}}"],
          "path": ["v2", "apps", "runs"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Classification démarrée\", function () {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.exist;",
              "    pm.collectionVariables.set(\"CLASSIFICATION_RUN_ID\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Vérifier statut classification",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
