{
  "info": {
    "_postman_id": "f2a3b7e1-4c9d-4e7a-9f8b-3c4d5e6f7890",
    "name": "AI Hub Document Processing",
    "description": "Collection pour automatiser l'analyse de 4 documents avec l'API AI Hub d'Instabase.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Créer un batch",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{API_TOKEN}}"
          },
          {
            "key": "IB-Context",
            "value": "{{IB_CONTEXT}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"financement-batch\"}"
        },
        "url": {
          "raw": "{{API_ROOT}}/v2/batches",
          "host": ["{{API_ROOT}}"],
          "path": ["v2", "batches"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Batch créé avec succès\", function () {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.exist;",
              "    pm.collectionVariables.set(\"BATCH_ID\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Téléverser kbis.pdf",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{API_TOKEN}}"
          },
          {
