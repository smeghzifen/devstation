          },
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          }
        ],
        "body": {
          "mode": "file",
          "file": {
            "src": "/path/to/kbis.pdf"
          }
        },
        "url": {
          "raw": "{{API_ROOT}}/v2/batches/{{BATCH_ID}}/files/kbis.pdf",
          "host": ["{{API_ROOT}}"],
          "path": ["v2", "batches", "{{BATCH_ID}}", "files", "kbis.pdf"]
        }
      },
      "response": []
