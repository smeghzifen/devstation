            "value": "{{IB_CONTEXT}}"
          }
        ],
        "url": {
          "raw": "{{API_ROOT}}/v2/apps/runs/{{CLASSIFICATION_RUN_ID}}/results?include_confidence_scores=true",
          "host": ["{{API_ROOT}}"],
          "path": ["v2", "apps", "runs", "{{CLASSIFICATION_RUN_ID}}", "results"],
          "query": [
            {
              "key": "include_confidence_scores",
              "value": "true"
            }
          ]
        }
      },
      "response": []
