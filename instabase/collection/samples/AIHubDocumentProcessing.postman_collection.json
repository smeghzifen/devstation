        ],
        "url": {
          "raw": "{{API_ROOT}}/v2/apps/runs/{{CLASSIFICATION_RUN_ID}}",
          "host": ["{{API_ROOT}}"],
          "path": ["v2", "apps", "runs", "{{CLASSIFICATION_RUN_ID}}"]
        }
      },
      "response": []
    },
    {
      "name": "5. Récupérer résultats classification",
      "request": {
        "method": "GET",
